# Server
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net
DB_NAME=blog_db

# JWT
ACCESS_TOKEN_SECRET=change_me_access_secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=change_me_refresh_secret
REFRESH_TOKEN_EXPIRY=7d

# Cloudinary (Dashboard → Settings → API Keys). Without these, image uploads return 503;
# everything else works. The secret is only ever used server-side to sign uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: root folder for uploads, one per environment (default: blog-management)
CLOUDINARY_FOLDER=blog-management
